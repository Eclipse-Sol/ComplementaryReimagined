#ifndef WSR_PLAYER_EQUIPMENT_SETTINGS
#define WSR_PLAYER_EQUIPMENT_SETTINGS

#define PLAYER_EQUIPMENT_CAPACITY 1024
#define PLAYER_EQUIPMENT_GROUP_SIZE 8
#define PLAYER_EQUIPMENT_GROUP_COUNT 128
#define PLAYER_EQUIPMENT_TILE_SIZE 32
#define PLAYER_EQUIPMENT_TILES_PER_ROW 32

ivec2 getEquipmentTileOrigin(uint slot) {
    return ivec2(slot % uint(PLAYER_EQUIPMENT_TILES_PER_ROW), slot / uint(PLAYER_EQUIPMENT_TILES_PER_ROW)) * PLAYER_EQUIPMENT_TILE_SIZE;
}

#endif
